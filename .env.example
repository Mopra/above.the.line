# ---------------------------------------------------------------------------
# SAFETY FIRST. Read this before you set anything.
#
# 1. Create the Bitvavo API key with "View" + "Trade" permissions ONLY.
#    NEVER enable "Withdraw". Bitvavo withdrawals made over the API do not
#    require 2FA or email confirmation, so a leaked key with withdraw rights
#    empties the account silently.
# 2. TRADING_ENABLED stays "false" until you have read a backtest you believe.
#    With it false the bot does everything except send real orders.
# ---------------------------------------------------------------------------

# --- Bitvavo credentials (Vercel: add as Environment Variables, never commit) --
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
# Bitvavo has rejected orders without an integer operatorId since 1 June 2025.
# The value is yours to pick; it just labels which bot placed an order. Any
# positive whole number works. Only matters once TRADING_ENABLED is true.
BITVAVO_OPERATOR_ID=1

# --- Master switches -------------------------------------------------------
# "true" = place real orders with real money. Anything else = dry run.
TRADING_ENABLED=false
# Set to "true" to halt everything immediately. Checked before any order.
KILL_SWITCH=false

# --- Capital limits (hard caps, enforced in code) ---------------------------
# Total EUR the bot is ever allowed to deploy. Keep it a little under what you
# actually deposited, so the 0.25% fee cannot push an order past your balance.
# On a EUR 100 deposit, 95 is a sensible number.
MAX_ALLOCATION_EUR=95
# Refuse to open a position if the account already holds more than this. Stops
# the bot from ever buying with money you did not mean to expose. Exits and the
# stop loss are deliberately NOT gated by it, so a position that grows past the
# ceiling can still be closed. Set it above where you expect the account to get,
# or the bot will simply stop opening new positions.
ACCOUNT_VALUE_CEILING_EUR=250

# --- Strategy --------------------------------------------------------------
MARKET=BTC-EUR
# Trend filter length in days. 140 days is about 20 weeks.
SMA_DAYS=140
# Weekday the weekly entry/exit signal is evaluated. 1 = Monday, 0 = Sunday.
SIGNAL_WEEKDAY=1
# Hard stop loss below entry price, checked every single day, not just weekly.
STOP_LOSS_PCT=20
# Safety valve against a runaway loop or a pathological signal.
MAX_TRADES_PER_MONTH=6

# --- Cron protection -------------------------------------------------------
# Vercel injects this automatically for its own cron calls. Set it yourself so
# nobody can trigger trades by guessing the URL.
CRON_SECRET=

# --- State storage ---------------------------------------------------------
# Created automatically when you add Vercel Blob to the project.
BLOB_READ_WRITE_TOKEN=
# Random string that prefixes the state path. Any long random value.
STATE_PREFIX=change-me-to-something-random

# --- Reporting -------------------------------------------------------------
# DKK per EUR, used only to present your SKAT figures in kroner.
DKK_PER_EUR=7.46
# Top marginal rate applied to crypto gains (personal income). Used for the
# after-tax column in the backtest only.
TAX_RATE_GAIN_PCT=42
# Deduction value of a loss (ligningsmaessigt fradrag), roughly 26 percent.
TAX_RATE_LOSS_PCT=26
